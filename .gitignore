# Build ROS2
build/
install/
log/

# VSCode
.vscode/

# Python
__pycache__/
*.pyc
.claude

# Dataset de entrenamiento (>1GB, no va en git)
datasets/

# Checkpoints y resultados de entrenamiento
hazmat/training/runs/

# Capturas automaticas de detecciones hazmat (evidencia para revision humana,
# no va en git — se regenera en cada prueba)
hazmat/alertas_detectadas/*
!hazmat/alertas_detectadas/.gitkeep

# Modelos base descargados automáticamente por ultralytics
yolov8n.pt
yolov8s.pt
yolov8m.pt

# El modelo entrenado final SÍ va en git (src/rescue_bringup/models/best.pt)
# para no ignorarlo accidentalmente:
!src/rescue_bringup/models/