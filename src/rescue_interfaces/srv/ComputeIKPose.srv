# Cinematica inversa desde una pose COMPLETA Td = [R | p].
# Recibe la matriz de rotacion completa del TCP activo. Solo resuelve/preview;
# los movimientos se solicitan mediante los servicios de trayectoria cartesiana.
float64   x
float64   y
float64   z
float64[] r        # matriz de rotacion 3x3 en orden fila-mayor (9 valores)
string    elbow    # "up" o "down"
---
bool      success
float64[] q_rad    # radianes en convencion DRIVER y orden joint_order (J1..J6)
float64   pos_err  # error de posicion alcanzado por la IK (m)
string    mensaje
